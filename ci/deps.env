# Dependency lock for release builds (see .github/workflows/release.yml).
#
# Sibling Go repos are pinned by exact commit SHA — the release workflow checks them
# out at these commits, so a tag rebuilds identically and never waits on a sibling
# repo having its own tag. To pick up newer sibling code: update the SHA (PR) and
# cut a new tag.
PROTOCOL_SHA=04308ed3a947067e8e14b5199b1495b845fea09c
SERVER_CORE_SHA=3edac6718802d215334c887a1493795c222dfff0

# The web console is downloaded BY THE SERVER AT RUNTIME from the web-console
# repo's public GitHub Releases (not embedded at build time). This value is the
# exact release tag stamped into the binary via
#   -ldflags "-X github.com/nettact/server-lite/internal/webui.Version=<tag>"
# It must be an exact vX.Y.Z[-pre] tag ("latest" is not valid — the runtime
# downloads one pinned version). Developers can serve a locally built dist with
# NETTACT_WEBUI_LOCAL, or point at a mirror with NETTACT_WEBUI_BASE_URL.
WEB_CONSOLE_VERSION=v0.1.0
