# Dependency lock for release builds (see .github/workflows/release.yml).
#
# Sibling Go repos are pinned by exact commit SHA — the release workflow checks them
# out at these commits, so a tag rebuilds identically and never waits on a sibling
# repo having its own tag. To pick up newer sibling code: update the SHA (PR) and
# cut a new tag.
PROTOCOL_SHA=04308ed3a947067e8e14b5199b1495b845fea09c
SERVER_CORE_SHA=68019bc6acc84366006c9202859a3b6d758d2160

# The embedded web console is consumed as a BUILT ARTIFACT from the web-console
# repo's GitHub Releases (not source):
#   latest  → newest web-console release at build time (actual version is recorded
#             in this repo's release notes; note: rebuilding the same lite tag later
#             may embed a newer frontend)
#   vX.Y.Z  → pin an exact web-console release for fully reproducible rebuilds
# Developers can override with WEBUI_SOURCE (see ci/fetch-webui.sh).
WEB_CONSOLE_VERSION=latest
